# Rawi — client variables. Copy to `.env`. Vite inlines every VITE_* value into
# the browser bundle, so nothing secret may ever be prefixed VITE_.
# `scripts/check-bundle-secrets.mjs` enforces that against `dist/`.
#
# The table this file mirrors is docs/OPERATIONS.md §5.3.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable only.
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# `fake` | `live`. Defaults to `fake`, which is what lets the whole gate run
# with no credentials and no spend.
VITE_API_MODE=fake
