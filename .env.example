# Rawi environment variables
# Copy this file to .env and fill in the values.
# The Worker reads these via Cloudflare secrets or wrangler.toml [vars].
# NEVER commit .env — it is listed in .gitignore.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found at: Supabase dashboard → Project → Settings → API

# Your project's public URL (safe to expose to the browser).
SUPABASE_URL=https://your-project-ref.supabase.co

# anon/public key — used by the client to verify JWTs. Safe to expose.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# service_role key — NEVER expose this. Used server-side to bypass RLS.
# Add as a Cloudflare secret: wrangler secret put SUPABASE_SERVICE_KEY
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT secret from Supabase (Settings → API → JWT Settings → JWT Secret).
# Used by the Worker to verify Supabase-issued JWTs without a network call.
# Add as a Cloudflare secret: wrangler secret put SUPABASE_JWT_SECRET
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── Application ──────────────────────────────────────────────────────────────
# Tutor mode: 'fixture' (default) or the name of a future AI provider.
RAWI_TUTOR_MODE=fixture
