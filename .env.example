# Rawi environment variables
# Copy this file to .env for command-line tools. The Worker uses `.dev.vars`
# locally and Wrangler settings/secrets when deployed. Never commit real values.

# Supabase public configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Server-only. Prefer `wrangler secret put SUPABASE_SERVICE_KEY` for deployment.
SUPABASE_SERVICE_KEY=sb_secret_...

# Application defaults
RAWI_STORAGE_MODE=fixture
RAWI_TUTOR_MODE=fixture

# Paid tutor/evaluation. Product calls also require configured global and
# per-learner monthly caps; the eval command requires its own explicit ceiling.
OPENAI_API_KEY=
RAWI_AI_GLOBAL_MONTHLY_CAP_USD=
RAWI_AI_LEARNER_MONTHLY_CAP_USD=
RAWI_LIVE_EVAL_MAX_USD=0.01
RAWI_OPENAI_MODEL=gpt-5.6-luna
RAWI_OPENAI_INPUT_USD_PER_MILLION=0.20
RAWI_OPENAI_OUTPUT_USD_PER_MILLION=1.20
