{
  "name": "rawi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:bundle": "node scripts/build-live.mjs && node scripts/check-bundle-secrets.mjs",
    "check:contrast": "node scripts/check-contrast.mjs --fail",
    "check:routes": "node scripts/check-routes.mjs",
    "worker:types": "wrangler types src/worker-configuration.d.ts",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:bundle && npm run check:contrast && npm run check:routes && wrangler deploy --dry-run && npm run e2e",
    "eval:live": "tsx scripts/live-ai-eval.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.6.14",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.12.4",
    "react-router-dom": "^7.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  },
  "allowScripts": {
    "workerd@1.20241230.0": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260911.1": true,
    "esbuild@0.28.2": true
  }
}
