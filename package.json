{
  "name": "rawi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && concurrently -k -n worker,web \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:backend": "npm run dev",
    "dev:worker": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "worker:types": "wrangler types worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "build": "vite build",
    "preview": "vite preview",
    "db:seed": "tsx dev/seed.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.28",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.7.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "domhandler": "^5.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.23",
    "htmlparser2": "^10.1.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.31.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "0.31.11",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "wrangler": "4.168.0"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "$katex"
    }
  }
}
