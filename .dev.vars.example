DATABASE_URL=postgresql://USER:PASSWORD@YOUR-DEVELOPMENT-ENDPOINT.neon.tech/DB?sslmode=require
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://localhost:5173
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# File actions only. Pasted materials do not need R2 configuration.
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET_NAME=rawi-materials-development
R2_ENVIRONMENT=development
R2_ACCESS_KEY_ID=YOUR_BUCKET_SCOPED_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_BUCKET_SCOPED_SECRET_ACCESS_KEY
# Optional engineering limits, in bytes except the pending count.
MATERIAL_MAX_FILE_BYTES=26214400
MATERIAL_MAX_TEXT_BYTES=1048576
MATERIAL_WORKSPACE_BYTES=1073741824
MATERIAL_PENDING_LIMIT=10

# Datalab key for PDF, DOCX and PPTX conversion. Without it those uploads keep only the original.
DATALAB_API_KEY=

# AI: every model call goes through OpenRouter. In OpenRouter's privacy settings, enforce zero data
# retention and exclude safety retention. Without a key, outlines use a rules pass and the tutor and
# question writing report that AI is unavailable.
OPENROUTER_API_KEY=
