# Rawi — server secrets. Copy to `.dev.vars` for local development; push the
# same keys to production with `wrangler secret put <KEY>`. Never commit
# `.dev.vars`, and never put any of these in `wrangler.jsonc` or a VITE_ var.
#
# The table this file mirrors is docs/OPERATIONS.md §5.1.

# ── Google Cloud / Vertex AI ────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.6-flash
GOOGLE_SA_CLIENT_EMAIL=rawi-vertex@your-gcp-project-id.iam.gserviceaccount.com
# Copy `private_key` out of the service-account JSON EXACTLY as it appears
# there — one line, with the literal \n escape sequences and the
# -----BEGIN PRIVATE KEY----- header intact. Do not reformat it. The client
# calls .replace(/\n/g, '\n') on read, and also accepts a real multi-line
# paste, so either form works.
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# Server only. Never in a VITE_* var, never in wrangler.jsonc.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── Cost control ────────────────────────────────────────────────────────────
# Paid AI fails closed: without BOTH caps and a provider credential, live mode
# is unavailable and the app runs on fixtures.
RAWI_AI_MONTHLY_CAP_USD=10
RAWI_AI_USER_MONTHLY_CAP_USD=1
# Owner-set from the Vertex pricing page, so a price change is a config edit
# and never a silent under-count.
VERTEX_INPUT_USD_PER_MILLION=0.20
VERTEX_OUTPUT_USD_PER_MILLION=1.20

# ── Opt-in live evaluation only (npm run eval:live) ─────────────────────────
RAWI_LIVE_EVAL_MAX_USD=0.01
