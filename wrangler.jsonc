{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rawi",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "vars": {
    "RAWI_TUTOR_MODE": "fixture",
    "RAWI_STORAGE_MODE": "supabase",
    "RAWI_OPENAI_MODEL": "gpt-5.6-luna",
    "RAWI_OPENAI_INPUT_USD_PER_MILLION": "0.20",
    "RAWI_OPENAI_OUTPUT_USD_PER_MILLION": "1.20",
    "RAWI_AI_TIMEOUT_MS": "8000",
    "RAWI_UPLOADS_ENABLED": "false",
    "RAWI_RETENTION_DAYS": "30",
    "SUPABASE_URL": "https://gxbexwtopazokvmpfyzj.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_vIXynYAvskDpPrUhIH8aXw_-JviV1JT"
  }
}
