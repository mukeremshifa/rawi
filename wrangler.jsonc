{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rawi",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "MATERIALS_BUCKET", "bucket_name": "rawi-materials-development", "remote": true }],
  // Hourly: queued jobs carry the work, and the sweep only catches what they missed.
  "triggers": { "crons": ["0 * * * *"] },
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "rawi-jobs" }],
    "consumers": [{ "queue": "rawi-jobs", "max_batch_size": 1, "max_retries": 5 }],
  },
  "dev": { "ip": "127.0.0.1", "port": 8788 },
}
