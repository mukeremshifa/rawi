{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rawi",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  // Non-secret configuration only. Every credential — including
  // SUPABASE_ANON_KEY, which used to be committed here — reaches production
  // through `wrangler secret put` and lives in .dev.vars locally. Config has
  // one home, and it is the table in docs/OPERATIONS.md.
  "vars": {
    "RAWI_AI_MODE": "fixture",
    "RAWI_INVITE_ONLY": "false",
    "RAWI_GOOGLE_OAUTH_ENABLED": "false",
    "RAWI_UPLOADS_ENABLED": "true",
    "RAWI_AI_TIMEOUT_MS": "20000",
    "RAWI_RETENTION_DAYS": "30"
  }
}
